NODE_ENV=development
LOG_LEVEL=debug

# Shopify app credentials from Partner Dashboard
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel.ngrok-free.app
# Must match access_scopes.scopes in shopify.app.toml and APP_SCOPES in
# lib/shopify/app-identity.ts (prod /api/health enforces exact parity).
SHOPIFY_SCOPES=read_orders,read_products,read_content,read_themes,write_script_tags

# 64 hex chars (32 bytes) for AES-256-GCM token encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Infrastructure
DATABASE_URL=postgresql://app:app@localhost:5432/searchgap?schema=public
REDIS_URL=redis://localhost:6379

# Email delivery
# RESEND_API_KEY=
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=
FROM_EMAIL=no-reply@searchgap.solnix.store
SUPPORT_EMAIL=support@searchgap.solnix.store
COMPANY_ADDRESS=SearchGap · Bangalore, India

# Analytics (optional)
# POSTHOG_KEY=  NEXT_PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=https://app.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Billing
BILLING_TEST_MODE=true
GROWTH_PLAN_PRICE_USD=9
GROWTH_PLAN_TRIAL_DAYS=14

# Observability (optional)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# METRICS_BEARER=  # bearer token required on /api/metrics in production

# Admin console
# ADMIN_EMAILS=you@company.com,teammate@company.com

# Privacy
PRIVACY_CONTACT_EMAIL=privacy@searchgap.solnix.store
# DPA_URL=

# Rate limits
# RATE_LIMIT_MERCHANT_PER_MIN=100
# RATE_LIMIT_PUBLIC_PER_MIN=30
# DASHBOARD_SUMMARY_CACHE_TTL_SEC=60

# Classification engine thresholds (optional — defaults are sensible)
# CLASSIFY_FUZZY_THRESHOLD=0.35
# CLASSIFY_SEMANTIC_THRESHOLD=0.72
# CLASSIFY_LOW_VOLUME_CUTOFF=5
# CLASSIFY_TYPE3_OCCURRENCE_MIN=10
# CLASSIFY_REVENUE_BAND_PCT=0.2
# CLASSIFY_QUERY_EMBEDDING_TTL_DAYS=7
# CLASSIFY_WINDOW_DAYS=30
# CLASSIFY_PARALLELISM=50




