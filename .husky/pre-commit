#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Block commits that contain known secret patterns. Requires gitleaks in PATH.
# On CI we run the full scan; locally this is the fast pre-commit version.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "warning: gitleaks not installed — skipping secret scan"
  echo "         install via: brew install gitleaks  OR  https://github.com/gitleaks/gitleaks/releases"
  exit 0
fi

gitleaks protect --staged --redact --verbose
